+#[derive(Deserialize)]
+pub struct CoreLoadTypeHint {
+    #[serde(deserialize_with = "deserialize_hex_u32")]
+    pub guard_address: u32,
+    #[serde(deserialize_with = "deserialize_hex_u32")]
+    pub guard_value: u32,
+    #[serde(deserialize_with = "deserialize_hex_u32")]
+    pub address: u32,
+    pub extensions: std::collections::BTreeMap<String, u32>,
+}
+
+impl CoreLoadTypeHint {
+    pub fn value_for(&self, path: &std::path::Path) -> u32 {
+        let Some(extension) = path.extension().and_then(|value| value.to_str()) else {
+            return 0;
+        };
+        self.extensions
+            .iter()
+            .find(|(name, _)| name.eq_ignore_ascii_case(extension))
+            .map(|(_, value)| *value)
+            .unwrap_or(0)
+    }
+}
+
+#[cfg(test)]
+mod load_type_hint_tests {
+    use super::CoreLoadTypeHint;
+    use std::{collections::BTreeMap, path::Path};
+
+    #[test]
+    fn extension_lookup_is_case_insensitive_and_unknown_is_zero() {
+        let hint = CoreLoadTypeHint {
+            guard_address: 0,
+            guard_value: 0,
+            address: 0x30,
+            extensions: BTreeMap::from([("gG".into(), 1), ("SMS".into(), 2)]),
+        };
+        assert_eq!(hint.value_for(Path::new("Game.GG")), 1);
+        assert_eq!(hint.value_for(Path::new("Game.sMs")), 2);
+        assert_eq!(hint.value_for(Path::new("Game.bin")), 0);
+        assert_eq!(hint.value_for(Path::new("Game")), 0);
+    }
+}
