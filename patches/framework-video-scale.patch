+package net.gamebub.framework.interface
+
+import chisel3._
+
+/** Optional display scaling control supplied by a core. */
+class VideoScaleV0 extends Bundle {
+  /** 0 = literal 3x, 1 = literal 2x; other values fall back to 3x. */
+  val mode = Output(UInt(2.W))
+}
