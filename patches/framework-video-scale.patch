+package net.gamebub.framework.interface
+
+import chisel3._
+
+/** Optional integer display scaling control supplied by a core. */
+class VideoScaleV0 extends Bundle {
+  /** Select 2x scaling; false retains the framework's maximum integer scale. */
+  val twoX = Output(Bool())
+}
