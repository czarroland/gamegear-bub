+package net.gamebub.framework.interface
+
+import chisel3._
+
+/** Optional completed-frame geometry in the core clock domain.
+  * The framework owns the framebuffer index; every other field belongs to the
+  * completed native frame. Width and height are bounded by VideoV0 capacity.
+  */
+class VideoViewportV0 extends Bundle {
+  val valid = Output(Bool())
+  val activeWidth = Output(UInt(9.W))
+  val activeHeight = Output(UInt(9.W))
+  val x0 = Output(UInt(9.W))
+  val y0 = Output(UInt(9.W))
+  val epoch = Output(UInt(8.W))
+  val frameId = Output(UInt(16.W))
+  val systemSms = Output(Bool())
+  val tvPal = Output(Bool())
+}
